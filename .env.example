PORT=3002
NODE_ENV=development

DB_HOST=localhost
DB_PORT=5432
DB_NAME=hospital_db
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# Each hospital gets its own database (hms_<slug>) on this server at signup, so DB_USER needs
# the CREATEDB privilege:  ALTER ROLE "<DB_USER>" CREATEDB;
# Max connections per hospital database pool.
TENANT_POOL_MAX=5

# Login session lifetime (hours). Cookie is Secure only when NODE_ENV=production.
SESSION_TTL_HOURS=12

# Frontend URL used in invitation links (…/accept-invite#token=…)
APP_URL=http://localhost:4200
# Invitation links expire after this many hours
INVITATION_TTL_HOURS=72

# Email (SMTP) for Doctor/Operator invitations. Leave SMTP_HOST empty in development:
# invitations are then not emailed, and the link is returned to the Superadmin UI + printed
# to the server console instead (never in production).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Hospital <no-reply@example.com>"

# MQTT broker (QStat devices)
MQTT_URL=mqtt://localhost:1883
MQTT_USERNAME=your_mqtt_user
MQTT_PASSWORD=your_mqtt_password
MQTT_TOPIC=your/topic
# Devices that aren't registered to any hospital yet are added to this hospital (its slug).
# Leave empty to ignore unregistered devices.
MQTT_DEFAULT_ORGANIZATION=
